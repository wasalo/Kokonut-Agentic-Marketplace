{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "types": ["node", "jest"]
  },
  "include": ["client.ts", "types.ts", "index.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
