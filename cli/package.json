{
  "name": "@kokonut/cli",
  "version": "0.1.0",
  "description": "CLI for Kokonut Agent Economy",
  "type": "module",
  "bin": {
    "kokonut": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/config && cp ../config/networks.js dist/config/networks.js",
    "start": "node dist/cli.js",
    "dev": "tsx cli.ts",
    "test": "jest --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "kokonut",
    "agent-economy",
    "cli"
  ],
  "author": "Kokonut Network",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "@open-wallet-standard/core": "^1.2.0",
    "viem": "^2.48.11"

  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.9.3"
  }
}
