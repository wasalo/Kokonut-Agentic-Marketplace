# =============================================================================
# KOKONUT AGENTIC MARKETPLACE - ENVIRONMENT CONFIGURATION
# Project: https://github.com/wasalo/Kokonut-Agentic-Marketplace
# Author: Wasabi @ Kokonut Network
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your values below
# 3. Never commit .env to Git (it should be in .gitignore)
# =============================================================================

# =============================================================================
# SECTION 1: WALLET & SECURITY (REQUIRED)
# =============================================================================

# Your wallet private key for contract deployment and interactions
# Format: 0x + 64 hex characters
# Get this from MetaMask, Ledger, or your preferred wallet
# SECURITY: NEVER share this publicly or commit to Git!
PRIVATE_KEY=your_private_key_here

# =============================================================================
# SECTION 2: NETWORK CONFIGURATION
# =============================================================================

# Ethereum Mainnet
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ETHEREUM_CHAIN_ID=1

# Sepolia Testnet
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
SEPOLIA_CHAIN_ID=11155111

# =============================================================================
# SECTION 3: API KEYS (OPTIONAL)
# =============================================================================

# Etherscan API Key for contract verification
# Get yours at: https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# 8004scan API Key for agent discovery
NEXT_PUBLIC_8004_API_KEY=your_8004scan_api_key_here

# Debug mode - set to 'true' only in development
# Leave empty or unset for production
NEXT_PUBLIC_DEBUG_MODE=

# =============================================================================
# SECTION 4: CONTRACT ADDRESSES (SEPOLIA - PHASE 29)
# Phase 29: Multi-Token Configurable Minimums + MilestoneEscrowV2 + PriceOracleV2
# =============================================================================

# Core Kokonut Contracts
AGENTIC_COMMERCE=0x4c592510e4FAbbEEA8D7142dE1f38d548b500e7f
AGENT_REVIEW=0x5CDb592Fd37749bF87448FBf5725D1Cd986dd1Cb
SERVICE_REGISTRY=0x62E1eeEa1A2Ab987004F35bDA430457Ed6077201
SKILL_REGISTRY=0xA84684261558f342d6871DD2CFef90A2117Aa20A
ADMIN_REGISTRY=0xC81C864CEAb6231ad764cf9867e031D8b6dee41d


# Tokens
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Official ERC-8004 Registries
ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713

# Infrastructure
PRICE_ORACLE=0x32fD2A54B722D2048A052fD0456004483a683aFE
MILESTONE_ESCROW=0xd4Fdc345b1c6aF1B4Cc84339bcB251B33527Eb45
COMMIT_REVEAL=0x85F193670fCb7B0c97D55E70Bf2a950b1065Fb3a
SLASH_MANAGER=0x1B8373cDF4f2eD740c3478e0129f0B8494CE4Fa3

# =============================================================================
# SECTION 5: FRONTEND CONFIGURATION (NEXT_PUBLIC_*)
# These variables are exposed to the browser
# =============================================================================

# WalletConnect Project ID for RainbowKit
# Get yours at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Sepolia RPC URL for frontend
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Frontend Contract Addresses (Phase 29)
NEXT_PUBLIC_AGENTIC_COMMERCE_ADDRESS=0x4c592510e4FAbbEEA8D7142dE1f38d548b500e7f
NEXT_PUBLIC_AGENT_REVIEW_ADDRESS=0x5CDb592Fd37749bF87448FBf5725D1Cd986dd1Cb
NEXT_PUBLIC_SERVICE_REGISTRY_ADDRESS=0x62E1eeEa1A2Ab987004F35bDA430457Ed6077201
NEXT_PUBLIC_SKILL_REGISTRY_ADDRESS=0xA84684261558f342d6871DD2CFef90A2117Aa20A
NEXT_PUBLIC_ADMIN_REGISTRY_ADDRESS=0xC81C864CEAb6231ad764cf9867e031D8b6dee41d
NEXT_PUBLIC_BIDDING_SYSTEM_ADDRESS=0x32c9d069a248a619d3EAc4D1FC76F2639AaBeF04
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_8004_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_8004_REPUTATION_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
