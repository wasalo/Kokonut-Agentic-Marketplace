{
  "name": "@kokonut/agent-economy-stack",
  "version": "0.1.0",
  "description": "The Kokonut Agent Economy Stack - Identity → Commerce → Coordination",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm run build:sdk && pnpm run build:projects",
    "build:sdk": "pnpm --filter @kokonut/sdk build",
    "build:cli": "pnpm --filter @kokonut/cli build",
    "build:projects": "pnpm -r --if-present run build",
    "cli": "pnpm --filter @kokonut/cli dev",
    "dev:web": "pnpm --filter @kokonut/web dev",
    "dev:web:turbo": "pnpm --filter @kokonut/web dev:turbo",
    "test": "pnpm run test:sdk",
    "test:sdk": "pnpm --filter @kokonut/sdk test",
    "test:cli": "pnpm --filter @kokonut/cli test",
    "test:gas": "cd contracts && forge test --match-contract GasSnapshot -vvv",
    "test:visual": "pnpm --filter @kokonut/web test:visual",
    "check:storage": "node scripts/check-storage-layout.js",
    "test:sepolia": "tsx scripts/sepolia-test.ts",
    "generate:addresses": "node scripts/generate-address-configs.js",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "type-check": "pnpm -r --if-present run type-check",
    "type-check:web": "pnpm --filter @kokonut/web type-check",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit fix",
    "outdated": "pnpm outdated",
    "update:deps": "pnpm update",
    "setup:foundry": "bash scripts/setup-foundry.sh",
    "test:contracts": "forge test -vvv",
    "type-check:web:strict": "pnpm --filter @kokonut/web type-check:strict",
    "docs:sdk": "typedoc --out docs/sdk-api sdk/typescript/index.ts"
  },
  "typedocOptions": {
    "entryPoints": [
      "sdk/typescript/index.ts"
    ],
    "out": "docs/sdk-api",
    "name": "Kokonut SDK API",
    "includeVersion": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "theme": "default",
    "sidebarLinks": {
      "GitHub": "https://github.com/anomalyco/kokonut-agentic-marketplace"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "keywords": [
    "kokonut",
    "agent-economy",
    "web3",
    "ai-agents",
    "erc-8004",
    "hackathon",
    "synthesis"
  ],
  "author": "Wasabi @ Kokonut Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasalo/Kokonut-Agentic-Marketplace"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@9.0.3": "9.0.7",
      "protobufjs@7.5.4": "7.5.8",
      "cross-spawn": "7.0.6",
      "semver": "7.6.3",
      "immutable": "5.1.5",
      "glob": "11.1.0",
      "undici": "7.26.0",
      "fast-uri": ">=3.1.2",
      "qs": ">=6.15.2",
      "ws": ">=8.20.1",
      "yaml": ">=2.8.3",
      "postcss": ">=8.5.10",
      "follow-redirects": ">=1.16.0",
      "bn.js": ">=5.2.3",
      "ejs": ">=3.1.10",
      "ip-address": ">=10.1.1",
      "dompurify": ">=3.4.0",
      "hono": ">=4.12.18",
      "js-yaml": ">=4.1.1",
      "tmp": ">=0.2.6",
      "uuid": "11.1.1",
      "axios@0.21.4": "0.32.0",
      "axios@1.13.6": "1.16.1",
      "axios@1.15.0": "1.16.1",
      "axios@1.16.0": "1.16.1"
    },
    "auditConfig": {
      "ignoreCves": ["CVE-2016-10538"]
    }
  },
  "devDependencies": {
    "@open-wallet-standard/core": "^1.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "docx": "^9.7.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typedoc": "^0.26.11",
    "typescript": "^5.9.3",
    "viem": "^2.51.2"
  }
}
