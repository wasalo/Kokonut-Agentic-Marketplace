{
  "name": "@kokonut/agent-economy-stack",
  "version": "0.1.0",
  "description": "The Kokonut Agent Economy Stack - Identity → Commerce → Coordination",
  "main": "dist/sdk/typescript/index.js",
  "types": "dist/sdk/typescript/index.d.ts",
  "bin": {
    "kokonut": "npx tsx cli/cli.ts"
  },
  "scripts": {
    "build": "npm run build:sdk && npm run build:projects",
    "build:sdk": "tsc -p sdk/typescript/tsconfig.json",
    "build:projects": "npm run build --workspaces --if-present",
    "cli": "npx tsx cli/cli.ts",
    "dev:web": "cd apps/web && npm run dev",
    "test": "npm run test:sdk && npm run test:projects",
    "test:sdk": "jest --config sdk/typescript/jest.config.js",
    "test:sepolia": "npx tsx scripts/sepolia-test.ts",
    "test:projects": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "rm -rf dist node_modules .turbo",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:ci": "npm audit --audit-level=moderate",
    "audit:high": "npm audit --audit-level=high",
    "outdated": "npm outdated",
    "update:deps": "npm update",
    "security:check": "npm audit --audit-level=high && npm outdated"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "sdk/typescript"
  ],
  "keywords": [
    "kokonut",
    "agent-economy",
    "web3",
    "ai-agents",
    "erc-8004",
    "hackathon",
    "synthesis"
  ],
  "author": "Wasabi @ Kokonut Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasalo/Kokonut-Agentic-Marketplace"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@eslint/plugin-kit": "^0.6.1",
    "@openzeppelin/contracts": "^4.9.6",
    "@prisma/client": "^6.11.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.96.1",
    "@types/web-push": "^3.6.4",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "envalid": "^8.0.0",
    "eslint-config-next": "^16.2.2",
    "ethers": "^6.16.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.2",
    "prisma": "^6.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "uuid": "^9.0.1",
    "viem": "^2.47.6",
    "wagmi": "^3.6.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.6.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
