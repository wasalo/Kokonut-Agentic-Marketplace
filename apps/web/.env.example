# =============================================================================
# API CONFIGURATION (Server-side only - NOT exposed to client)
# =============================================================================

# 8004scan API Key (for agent discovery, proxied server-side)
_8004_API_KEY=your_8004scan_api_key_here

# Coinbase CDP API Key (for x402 payments, proxied server-side)
CDP_API_KEY=your_cdp_api_key_here

# =============================================================================
# RPC CONFIGURATION
# =============================================================================

NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================

# Mixpanel token (get from https://mixpanel.com)
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# =============================================================================
# DEBUG CONFIGURATION
# =============================================================================

# Set to 'true' to enable debug mode (only in development)
NEXT_PUBLIC_DEBUG_MODE=
